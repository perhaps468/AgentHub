# =============================================================================
# AgentHub .gitignore
# =============================================================================

# -------- Python --------

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytest-cache-files-*/

# Translations
*.mo
*.pot

# Django stuff:
*.log
local_settings.py

# Flask stuff:
instance/
.webassets-cache

# Scrapy stuff:
.scrapy

# Sphinx documentation
docs/_build/

# PyBuilder
target/

# Jupyter Notebook
.ipynb_checkpoints

# IPython
profile_default/
ipython_config.py

# pyenv
.python-version

# celery beat schedule file
celerybeat-schedule

# SageMath parsed files
*.sage.py

# Environments
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/

# Spyder project settings
.spyderproject
.spyproject

# Rope project settings
.ropeproject

# mkdocs documentation
/site

# mypy
.mypy_cache/
.dmypy.json
dmypy.json

# Pyre type checker
.pyre/

# -------- Node / pnpm --------

# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
build/
*.tsbuildinfo

# npm/pnpm debug logs
npm-debug.log*
pnpm-debug.log*

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# -------- OS --------

# macOS
.DS_Store
.AppleDouble
.LSOverride

# Thumbnails
._*

# Files that might appear on external disk
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs.db:*.log

# Linux
*~

# KDE directory preferences
.directory

# -------- IDE --------

# JetBrains
.idea/
*.iml

# VS Code
.vscode/

# -------- AgentHub Specific --------

# Memory bank (planning docs, design docs)
memory-bank/

# VFS output directory (generated at runtime)
tmp/
.tmp/

# Local package manager/runtime caches
.corepack/

# SQLite databases
*.db
*.sqlite
*.sqlite3

# PostgreSQL data (if any)
postgres_data/

# Redis data (if any)
redis_data/

# Docker volumes (if any)
docker/data/
# Uploaded files
uploads/

# Logs
*.log
logs/
.cursor/*.log
*/backend/.audit/

# Alembic ini (auto-generated)
alembic.ini

# Coverage reports
htmlcov/

# Virtual environment
.env.local
.env.*.local

# Test databases
test.db

# Local test files (development only)
backend/test_*.py
frontend/src/**/*.spec.ts
frontend/src/veiws/

# Backend tests directory
backend/tests/

# OpenSpec / migration docs
openspec/docs/

# Secrets (MUST NEVER be committed)
*.pem
*.key
credentials.json
secrets.json
